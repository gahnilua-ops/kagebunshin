# KageBunshin MCP Server — Environment Config
# Copy this to .env and fill in your values

# Required
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Server port (default: 3456)
PORT=3456

# Optional: Bearer token to protect the SSE endpoint
# Set this and pass it from Kai 9000 as Authorization: Bearer <token>
KB_API_KEY=your-secret-token-here
